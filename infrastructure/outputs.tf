locals {
  api_url          = "${aws_apigatewayv2_api.http.api_endpoint}/documents"
  cognito_issuer   = "https://${aws_cognito_user_pool.users.endpoint}"
  cognito_login_ui = "https://${aws_cognito_user_pool_domain.login.domain}.auth.${var.region}.amazoncognito.com"
}

# The frontend reads these at build time (Vite exposes VITE_* variables).
resource "local_file" "frontend_env" {
  filename        = "${path.module}/../frontend/.env.local"
  file_permission = "0644"
  content         = <<-EOT
    # Generated by Terraform (infrastructure/outputs.tf). Do not edit by hand.
    VITE_API_URL=${local.api_url}
    VITE_COGNITO_AUTHORITY=${local.cognito_issuer}
    VITE_COGNITO_CLIENT_ID=${aws_cognito_user_pool_client.web.id}
    VITE_COGNITO_DOMAIN=${local.cognito_login_ui}
  EOT
}

output "api_url" {
  description = "Base URL the frontend calls."
  value       = local.api_url
}

output "cognito_user_pool_id" {
  value = aws_cognito_user_pool.users.id
}

output "cognito_client_id" {
  value = aws_cognito_user_pool_client.web.id
}

output "cognito_login_url" {
  value = local.cognito_login_ui
}

output "documents_bucket" {
  value = aws_s3_bucket.documents.bucket
}

output "documents_table" {
  value = aws_dynamodb_table.documents.name
}

output "dashboard_url" {
  value = "https://${var.region}.console.aws.amazon.com/cloudwatch/home?region=${var.region}#dashboards/dashboard/${aws_cloudwatch_dashboard.main.dashboard_name}"
}

output "create_user_command" {
  description = "Run this to create your login (Cognito sends a temporary password by email)."
  value       = "aws cognito-idp admin-create-user --region ${var.region} --user-pool-id ${aws_cognito_user_pool.users.id} --username YOUR_EMAIL --user-attributes Name=email,Value=YOUR_EMAIL Name=email_verified,Value=true"
}
